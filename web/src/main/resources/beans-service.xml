<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
		https://www.springframework.org/schema/beans/spring-beans.xsd">

    <import resource="beans-dao.xml"/>

    <bean id="passwordService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.account.PasswordServiceImpl">
        <constructor-arg ref="passwordDaoImpl"/>
    </bean>

    <bean id="phoneService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.account.PhoneServiceImpl">
        <constructor-arg ref="phoneDaoImpl"/>
    </bean>

    <bean id="accountService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.account.AccountServiceImpl">
        <constructor-arg ref="accountDaoImpl"/>
        <constructor-arg ref="friendshipDaoImpl"/>
        <constructor-arg ref="friendshipCheckerDaoImpl"/>
        <constructor-arg ref="phoneService"/>
        <constructor-arg ref="phoneDaoImpl"/>
        <constructor-arg ref="passwordServiceImpl"/>
        <constructor-arg ref="passwordDaoImpl"/>
        <constructor-arg ref="transactionManager"/>
    </bean>

    <bean id="loginService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.account.LoginServiceImpl">
        <constructor-arg ref="accountService"/>
        <constructor-arg ref="passwordServiceImpl"/>
    </bean>

    <bean id="adminService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.account.AdminServiceImpl">
        <constructor-arg ref="accountService"/>
    </bean>

    <bean id="messageService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.message.MessageServiceImpl">
        <constructor-arg ref="groupMessageDaoImpl"/>
        <constructor-arg ref="personalWallMessageDaoImpl"/>
        <constructor-arg ref="personalMessageDaoImpl"/>
        <constructor-arg ref="accountService"/>
    </bean>

    <bean id="groupService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.group.GroupServiceImpl">
        <constructor-arg ref="groupDaoImpl"/>
    </bean>

    <bean id="groupMembershipService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.group.GroupMembershipServiceImpl">
        <constructor-arg ref="accountService"/>
        <constructor-arg ref="groupMembershipDaoImpl"/>
    </bean>

    <bean id="searchService"
          class="com.getjavajob.training.timashovy.socialnetwork.service.serviceimpl.search.SearchServiceImpl">
        <constructor-arg ref="searchAccountDaoImpl"/>
        <constructor-arg ref="searchGroupDaoImpl"/>
    </bean>

</beans>