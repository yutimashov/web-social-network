<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>social-network</display-name>

    <servlet>
        <servlet-name>Accounts</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.AccountsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Accounts</servlet-name>
        <url-pattern>/accounts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Registration</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.RegistrationServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>20971520</max-request-size>
            <file-size-threshold>5242880</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>Registration</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Login</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Account</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.AccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Account</servlet-name>
        <url-pattern>/account</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>Edit Account</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.EditAccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Edit Account</servlet-name>
        <url-pattern>/edit-account</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Account Avatar</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.AccountAvatarServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Account Avatar</servlet-name>
        <url-pattern>/avatar</url-pattern>
    </servlet-mapping>
    
    <session-config>
        <session-timeout>10</session-timeout>
    </session-config>

    <filter>
        <filter-name>Show Username Filter</filter-name>
        <filter-class>com.getjavajob.training.timashovy.socialnetwork.web.filters.ShowUserNameFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>Show Username Filter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>