<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>social-network</display-name>

    <resource-ref>
        <description>DB Connection</description>
        <res-ref-name>jdbc/socialNetwork</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <!-- listeners -->

    <!-- Spring Web Context initializer -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener
        </listener-class>
    </listener>
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:beans.xml</param-value>
    </context-param>

    <!-- dispatcher servlet -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet
        </servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>classpath:dispatcher-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- account servlets -->

    <servlet>
        <servlet-name>Edit Account</servlet-name>
        <servlet-class>com.getjavajob.training.timashovy.socialnetwork.web.servlets.account.EditAccountServlet
        </servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>5242880</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>Edit Account</servlet-name>
        <url-pattern>/account/edit</url-pattern>
    </servlet-mapping>

    <!-- session config -->
    <session-config>
        <session-timeout>10</session-timeout>
    </session-config>

    <!-- filters -->
    <filter>
        <filter-name>Remember Me</filter-name>
        <filter-class>com.getjavajob.training.timashovy.socialnetwork.web.filters.RememberMeFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>Remember Me</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>IsAuthorizedFilter</filter-name>
        <filter-class>com.getjavajob.training.timashovy.socialnetwork.web.filters.IsAuthorizedFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>IsAuthorizedFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>FriendshipRecordExistenceFilter</filter-name>
        <filter-class>com.getjavajob.training.timashovy.socialnetwork.web.filters.FriendRecordExistenceFilter
        </filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FriendshipRecordExistenceFilter</filter-name>
        <url-pattern>/account</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>Set Encoding Filter</filter-name>
        <filter-class>com.getjavajob.training.timashovy.socialnetwork.web.filters.SetEncodingFilter
        </filter-class>
    </filter>
    <filter-mapping>
        <filter-name>Set Encoding Filter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error/404.jsp</location>
    </error-page>

</web-app>
